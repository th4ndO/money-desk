# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables (Production and Preview).

# Supabase project URL and anon (public) key: Supabase dashboard →
# Project Settings → API. Both are safe to expose to the browser; Row Level
# Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The only email address allowed to sign in. Server-only.
ALLOWED_EMAIL=

# Server-only secret (32+ random characters) mixed into the sign-in PIN so the
# PIN can't be guessed against Supabase directly. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates the current PIN (set a new one via the email link).
PIN_PEPPER=

# There is deliberately no SUPABASE_SERVICE_ROLE_KEY: the app never needs it.
